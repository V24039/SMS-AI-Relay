<?xml version="1.0" encoding="utf-8"?>
<!-- API key, allowlist and (later) conversation history must never leave this device.
     allowBackup="false" covers Android 11 and below; on 12+ this file also blocks
     device-to-device transfer, which allowBackup alone no longer does. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
